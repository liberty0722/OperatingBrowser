# AI API Configuration
# 支持 OpenAI 或任何兼容 API（如 DeepSeek、通义千问等）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Browser Configuration
HEADLESS=false
BROWSER_TYPE=chromium
# 浏览器连接模式:
#   reuse      - 复用已有浏览器（保留登录态/Cookie，需先以 --remote-debugging-port 启动 Chrome）
#   standalone - 启动独立 Chrome 实例（空白 Profile，不影响已有浏览器）
#   builtin    - 使用 Playwright 内置 Chromium
BROWSER_MODE=reuse
CDP_URL=http://127.0.0.1:9222
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=true
